rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // accessControl/{uid} is trusted authorization data. The Chairperson's
    // initial admin record is provisioned in Firebase Console.
    // members/{uid} is the Auth user's application and approval record.
    function signedIn() {
      return request.auth != null;
    }

    function verifiedCollegeAccount() {
      return signedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email.matches('^[^\\s@]+@tcetmumbai\\.in$');
    }

    function hasAccessRole(role) {
      return verifiedCollegeAccount() &&
        exists(/databases/$(database)/documents/accessControl/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/accessControl/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasAccessRole('admin');
    }

    function isCoreTeam() {
      return hasAccessRole('coreTeam') &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.membershipStatus == 'active' &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'core_team';
    }

    function isEventManager() {
      return isAdmin() || isCoreTeam() || hasAccessRole('eventManager');
    }

    function isApprovedMember(memberId) {
      return exists(/databases/$(database)/documents/members/$(memberId)) &&
        get(/databases/$(database)/documents/members/$(memberId)).data.membershipStatus == 'active';
    }

    function validMember(data, memberId) {
      return data.keys().hasAll([
          'fullName',
          'collegeEmail',
          'rollNumber',
          'className',
          'division',
          'academicYear',
          'phoneNumber',
          'profilePhotoUrl',
          'membershipStatus',
          'role',
          'aicteHours',
          'createdAt',
          'updatedAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 120 &&
        data.collegeEmail is string &&
        data.collegeEmail.matches('^[^\\s@]+@tcetmumbai\\.in$') &&
        data.rollNumber is string &&
        data.rollNumber.size() > 0 &&
        data.rollNumber.size() <= 40 &&
        data.className is string &&
        data.className.size() > 0 &&
        data.className.size() <= 40 &&
        data.division is string &&
        data.division.size() > 0 &&
        data.division.size() <= 20 &&
        data.academicYear is string &&
        data.academicYear.size() > 0 &&
        data.academicYear.size() <= 20 &&
        data.phoneNumber is string &&
        data.phoneNumber.size() <= 30 &&
        data.profilePhotoUrl is string &&
        data.profilePhotoUrl.size() <= 2048 &&
        (data.profilePhotoUrl == '' ||
          data.profilePhotoUrl.matches('^https://[^\\s]+$')) &&
        data.membershipStatus in ['pending', 'active', 'inactive', 'rejected'] &&
        data.role in ['member', 'core_team', 'wc'] &&
        data.aicteHours is number &&
        data.aicteHours >= 0 &&
        data.aicteHours <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        memberId is string;
    }

    function validSelfRegistration(data, memberId) {
      return verifiedCollegeAccount() &&
        request.auth.uid == memberId &&
        data.keys().hasOnly([
          'fullName',
          'collegeEmail',
          'rollNumber',
          'className',
          'division',
          'academicYear',
          'phoneNumber',
          'profilePhotoUrl',
          'membershipStatus',
          'role',
          'aicteHours',
          'createdAt',
          'updatedAt'
        ]) &&
        validMember(data, memberId) &&
        data.collegeEmail == request.auth.token.email &&
        data.membershipStatus == 'pending' &&
        data.role == 'member' &&
        data.aicteHours == 0 &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function validEvent(eventId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'name',
          'date',
          'location',
          'domain',
          'category',
          'participants',
          'objective',
          'outcome',
          'image',
          'gallery',
          'status'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'date',
          'location',
          'domain',
          'category',
          'participants',
          'objective',
          'outcome',
          'image',
          'gallery',
          'status'
        ]) &&
        data.id is string &&
        data.id == eventId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 160 &&
        data.date is string &&
        data.date.size() > 0 &&
        data.date.size() <= 100 &&
        data.location is string &&
        data.location.size() <= 200 &&
        data.domain is string &&
        data.domain.size() <= 80 &&
        data.category is string &&
        data.category.size() <= 80 &&
        data.participants is string &&
        data.participants.size() <= 80 &&
        data.objective is string &&
        data.objective.size() <= 2000 &&
        data.outcome is string &&
        data.outcome.size() <= 2000 &&
        data.image is string &&
        data.image.size() <= 2048 &&
        data.gallery is list &&
        data.gallery.size() <= 30 &&
        data.status in ['draft', 'published'];
    }

    match /events/{eventId} {
      allow get, list: if isEventManager() ||
        resource.data.status == 'published';
      allow create, update: if isEventManager() && validEvent(eventId);
      allow delete: if isEventManager();
    }

    match /accessControl/{userId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['role']) &&
        request.resource.data.keys().hasAll(['role']) &&
        request.resource.data.role in ['coreTeam', 'eventManager'] &&
        exists(/databases/$(database)/documents/members/$(userId)) &&
        get(/databases/$(database)/documents/members/$(userId)).data.membershipStatus == 'active' &&
        (
          request.resource.data.role != 'coreTeam' ||
          get(/databases/$(database)/documents/members/$(userId)).data.role == 'core_team'
        );
      allow delete: if isAdmin() &&
        resource.data.role in ['coreTeam', 'eventManager'];
    }

    match /members/{memberId} {
      allow get: if isAdmin() ||
        (isCoreTeam() && resource.data.membershipStatus == 'active') ||
        (verifiedCollegeAccount() && request.auth.uid == memberId);
      allow list: if isAdmin() ||
        (isCoreTeam() && resource.data.membershipStatus == 'active');
      allow create: if validSelfRegistration(request.resource.data, memberId) ||
        (isAdmin() && validMember(request.resource.data, memberId));
      allow update: if
        (isAdmin() && validMember(request.resource.data, memberId)) ||
        (isCoreTeam() &&
          resource.data.membershipStatus == 'active' &&
          request.resource.data.membershipStatus == resource.data.membershipStatus &&
          request.resource.data.role == resource.data.role &&
          validMember(request.resource.data, memberId)) ||
        (verifiedCollegeAccount() &&
          request.auth.uid == memberId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['phoneNumber', 'profilePhotoUrl', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time &&
          validMember(request.resource.data, memberId));
      allow delete: if isAdmin();

      match /{memberCollection}/{memberDocument=**} {
        allow read: if isAdmin() ||
          (isCoreTeam() && isApprovedMember(memberId)) ||
          (verifiedCollegeAccount() &&
            request.auth.uid == memberId &&
            isApprovedMember(memberId));
        allow create, update, delete: if isAdmin() ||
          (isCoreTeam() && isApprovedMember(memberId));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
