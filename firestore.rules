rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model:
    // accessControl/{authUid}: role is "admin", "coreTeam", or "eventManager".
    // Firebase Console/IAM administrators manage these records; all client
    // reads and writes are denied. Never store the authoritative role on a
    // member-editable profile.
    // members/{authUid}: profile and club fields; members may edit only their
    // own phoneNumber and profilePhotoUrl. Nested club records are private.
    function signedIn() {
      return request.auth != null;
    }

    function hasAccessRole(role) {
      return signedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/accessControl/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/accessControl/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasAccessRole('admin');
    }

    function isCoreTeam() {
      return hasAccessRole('coreTeam');
    }

    function canManageMembers() {
      return isAdmin() || isCoreTeam();
    }

    function isEventManager() {
      return isAdmin() || isCoreTeam() || hasAccessRole('eventManager');
    }

    function validMember(data, memberId) {
      return data.keys().hasAll([
          'fullName',
          'collegeEmail',
          'rollNumber',
          'className',
          'division',
          'academicYear',
          'phoneNumber',
          'profilePhotoUrl',
          'membershipStatus',
          'role',
          'aicteHours',
          'createdAt',
          'updatedAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 120 &&
        data.collegeEmail is string &&
        data.collegeEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.rollNumber is string &&
        data.rollNumber.size() > 0 &&
        data.rollNumber.size() <= 40 &&
        data.className is string &&
        data.className.size() > 0 &&
        data.className.size() <= 40 &&
        data.division is string &&
        data.division.size() > 0 &&
        data.division.size() <= 20 &&
        data.academicYear is string &&
        data.academicYear.size() > 0 &&
        data.academicYear.size() <= 20 &&
        data.phoneNumber is string &&
        data.phoneNumber.size() <= 30 &&
        data.profilePhotoUrl is string &&
        data.profilePhotoUrl.size() <= 2048 &&
        (data.profilePhotoUrl == '' ||
          data.profilePhotoUrl.matches('^https://[^\\s]+$')) &&
        data.membershipStatus in ['pending', 'active', 'inactive'] &&
        data.role in ['member', 'core_team', 'wc'] &&
        data.aicteHours is number &&
        data.aicteHours >= 0 &&
        data.aicteHours <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        memberId is string;
    }

    function validEvent(eventId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'name',
          'date',
          'location',
          'domain',
          'category',
          'participants',
          'objective',
          'outcome',
          'image',
          'gallery',
          'status'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'date',
          'location',
          'domain',
          'category',
          'participants',
          'objective',
          'outcome',
          'image',
          'gallery',
          'status'
        ]) &&
        data.id is string &&
        data.id == eventId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 160 &&
        data.date is string &&
        data.date.size() > 0 &&
        data.date.size() <= 100 &&
        data.location is string &&
        data.location.size() <= 200 &&
        data.domain is string &&
        data.domain.size() <= 80 &&
        data.category is string &&
        data.category.size() <= 80 &&
        data.participants is string &&
        data.participants.size() <= 80 &&
        data.objective is string &&
        data.objective.size() <= 2000 &&
        data.outcome is string &&
        data.outcome.size() <= 2000 &&
        data.image is string &&
        data.image.size() <= 2048 &&
        data.gallery is list &&
        data.gallery.size() <= 30 &&
        data.status in ['draft', 'published'];
    }

    match /events/{eventId} {
      allow get, list: if isEventManager() ||
        resource.data.status == 'published';
      allow create, update: if isEventManager() && validEvent(eventId);
      allow delete: if isEventManager();
    }

    match /accessControl/{userId} {
      allow read, write: if false;
    }

    match /members/{memberId} {
      allow get, list: if canManageMembers() ||
        (signedIn() && request.auth.uid == memberId &&
          request.auth.token.email_verified == true);
      allow create: if validMember(request.resource.data, memberId) &&
        (
          (isAdmin() && request.resource.data.role in ['member', 'core_team', 'wc']) ||
          (isCoreTeam() && request.resource.data.role in ['member', 'wc'])
        );
      allow update: if signedIn() &&
        (
          (isAdmin() &&
            validMember(request.resource.data, memberId)) ||
          (isCoreTeam() &&
            (
              request.resource.data.role == resource.data.role ||
              (resource.data.role != 'core_team' &&
                request.resource.data.role in ['member', 'wc'])
            ) &&
            validMember(request.resource.data, memberId)) ||
          (request.auth.uid == memberId &&
            request.auth.token.email_verified == true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['phoneNumber', 'profilePhotoUrl', 'updatedAt']) &&
            request.resource.data.updatedAt == request.time &&
            validMember(request.resource.data, memberId))
        );
      allow delete: if canManageMembers();

      match /{memberCollection}/{memberDocument=**} {
        allow read: if canManageMembers() ||
          (signedIn() && request.auth.uid == memberId &&
            request.auth.token.email_verified == true);
        allow create, update, delete: if canManageMembers();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
