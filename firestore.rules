rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{Auth UID}: application profile and live, owner/admin-verified authority.
    // events/{auto ID}: portal events; attendance/{UID}__{event ID}: unique pair.
    // settings/club: non-sensitive academic session and AICTE conversion settings.
    // Bootstrap: trusted project owner provisions one verified Auth UID via IAM.
    // No client can create an approved profile or modify its own authorization.
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }
    function admin() {
      return approved() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Chairperson', 'Mentor'];
    }
    function roleValid(role) {
      return role in ['Mentor', 'Chairperson', 'Vice Chairperson', 'Creative Head', 'Documentation Head', 'Event Management Head', 'Technical Head', 'Working Committee - Technical', 'Working Committee - Creative', 'Working Committee - Event', 'Working Committee - Documentation', 'Member', 'Guest'];
    }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function session(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}$'); }
    function validUser(d) {
      return d.keys().hasAll(['name', 'email', 'branch', 'division', 'year', 'academicYear', 'requestedRole', 'role', 'approvalStatus', 'createdAt', 'approvedAt', 'approvedBy']) &&
        d.keys().hasOnly(['name', 'email', 'branch', 'division', 'year', 'academicYear', 'requestedRole', 'role', 'approvalStatus', 'createdAt', 'approvedAt', 'approvedBy', 'rejectionReason']) &&
        text(d.name, 120) && text(d.email, 254) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        d.branch in ['Comp', 'AIML', 'AIDS', 'IOT', 'Mech', 'ECS', 'Civil', 'CSE(CS)', 'CSE(IoT)', 'EXTC', 'IT'] &&
        d.division in ['A', 'B', 'C', 'D'] && d.year in ['SE', 'TE', 'BE'] && session(d.academicYear) &&
        roleValid(d.requestedRole) && roleValid(d.role) && d.approvalStatus in ['pending', 'approved', 'rejected'] &&
        d.createdAt is timestamp && (d.approvedAt == null || d.approvedAt is timestamp) &&
        (d.approvedBy == null || text(d.approvedBy, 128)) &&
        (!('rejectionReason' in d) || (d.rejectionReason is string && d.rejectionReason.size() <= 1000));
    }
    function validEvent(d) {
      return d.keys().hasAll(['name', 'academicYear', 'date', 'aicteHours', 'description', 'createdAt', 'createdBy']) &&
        d.keys().hasOnly(['name', 'academicYear', 'date', 'aicteHours', 'description', 'createdAt', 'createdBy']) &&
        text(d.name, 160) && session(d.academicYear) && d.date is timestamp &&
        d.aicteHours is number && d.aicteHours > 0 && d.aicteHours <= 10000 &&
        d.description is string && d.description.size() <= 4000 &&
        d.createdAt is timestamp && text(d.createdBy, 128);
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || admin() || (approved() && resource.data.approvalStatus == 'approved');
      // Ordinary members must query approvalStatus == approved; rules are not filters.
      allow list: if admin() || (approved() && resource.data.approvalStatus == 'approved');
      allow create: if isOwner(uid) && validUser(request.resource.data) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.approvalStatus == 'pending' && request.resource.data.role == 'Member' &&
        request.resource.data.approvedAt == null && request.resource.data.approvedBy == null &&
        !('rejectionReason' in request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if admin() && !isOwner(uid) && validUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'approvalStatus', 'approvedAt', 'approvedBy', 'rejectionReason']) &&
        request.resource.data.approvedBy == request.auth.uid &&
        ((request.resource.data.approvalStatus == 'approved' && request.resource.data.approvedAt == request.time) ||
         (request.resource.data.approvalStatus == 'rejected' && request.resource.data.role == 'Member' && request.resource.data.approvedAt == null));
      allow delete: if false;
    }
    match /events/{eventId} {
      allow read: if approved();
      allow create: if admin() && eventId.matches('^[A-Za-z0-9]{20}$') && validEvent(request.resource.data) &&
        request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && validEvent(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'date', 'aicteHours', 'description']);
      allow delete: if false;
    }
    match /attendance/{pairId} {
      allow read: if approved();
      allow create, update: if admin() &&
        request.resource.data.keys().hasAll(['memberId', 'eventId', 'attended', 'updatedAt', 'updatedBy']) &&
        request.resource.data.keys().hasOnly(['memberId', 'eventId', 'attended', 'updatedAt', 'updatedBy']) &&
        text(request.resource.data.memberId, 128) && request.resource.data.eventId is string &&
        request.resource.data.eventId.matches('^[A-Za-z0-9]{20}$') &&
        pairId == request.resource.data.memberId + '__' + request.resource.data.eventId &&
        request.resource.data.attended is bool && request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.memberId)) &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.approvalStatus == 'approved' &&
        get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.academicYear ==
          get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.academicYear;
      allow delete: if false;
    }
    match /settings/{id} {
      // Needed to populate the registration form before a visitor has an account.
      allow get: if id == 'club';
      allow list: if false;
      allow create, update, delete: if false; // Trusted owner/IAM only; preserves existing settings.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
